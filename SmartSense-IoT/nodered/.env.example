# ==========================================
# SmartSense Node-RED & Firebase Environment
# ==========================================

# Server & Runtime
PORT=1880
NODE_ENV=development

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_SENSOR_TOPIC=smartsense/room1/sensors
MQTT_ALERT_TOPIC=smartsense/room1/alerts
MQTT_STATUS_TOPIC=smartsense/room1/status

# Configurable Sensor Alert Thresholds
TEMPERATURE_WARNING=32.0
TEMPERATURE_CRITICAL=35.0
DISTANCE_ALERT=15.0
HUMIDITY_WARNING=75.0

# Firebase Realtime Database Configuration (Placeholders only - Never commit real keys)
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_SECRET=
