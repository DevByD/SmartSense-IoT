# ============================================================
# SmartSense IoT — Raspberry Pi 4B Configuration
# ============================================================

# Device Metadata
DEVICE_ID=smartsense-pi-01
ROOM=Room 1

# MQTT Broker Configuration
# For local broker on the same machine, use localhost or 127.0.0.1.
# When running on physical Pi across the network, set this to the Host IP running the MQTT Broker.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=smartsense/room1/sensors
MQTT_CLIENT_ID=smartsense-pi-01-hardware

# Telemetry Sampling Interval (seconds)
# Default is 2.0s to match simulator frequency
SAMPLING_INTERVAL_SECONDS=2.0

# Physical GPIO Pin Mapping (BCM Numbering)
DHT22_PIN=4
HCSR04_TRIG_PIN=23
HCSR04_ECHO_PIN=24
PIR_PIN=27
SOUND_PIN=22
TOUCH_PIN=18

# Sensor Electrical Configuration
# Set to false if your digital sound module outputs LOW on trigger (Active LOW)
SOUND_ACTIVE_HIGH=true
# Set to false if your digital touch module outputs LOW on touch
TOUCH_ACTIVE_HIGH=true

# Ultrasonic Sensor Timeout (milliseconds)
# Maximum echo listening window to avoid blocking execution (~35ms corresponds to ~6 meters)
HCSR04_TIMEOUT_MS=35
