# ==========================================
# SmartSense IoT System Configuration
# ==========================================

# MQTT Broker Settings
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=smartsense-backend
MQTT_SENSOR_TOPIC=smartsense/room1/sensors
MQTT_ALERT_TOPIC=smartsense/room1/alerts
MQTT_STATUS_TOPIC=smartsense/room1/status

# Backend & Node-RED Ports
BACKEND_PORT=5000
NODERED_PORT=1880
NODE_ENV=development

# Firebase Realtime Database Configuration (Placeholders only)
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_SECRET=

# Firebase Web Client (for Frontend React App)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Configurable Sensor Alert Thresholds
TEMPERATURE_WARNING=32.0
TEMPERATURE_CRITICAL=35.0
DISTANCE_ALERT=15.0
HUMIDITY_WARNING=75.0
