# ============================================================
# SmartSense IoT - Backend Environment Configuration Template
# ============================================================
# DO NOT place actual secrets or production keys in this file.
# Copy this file to .env and configure local values.

# Server Configuration
PORT=5000
NODE_ENV=development
DEFAULT_DEVICE_ID=smartsense-pi-01

# CORS Allowed Origin (Frontend URL)
FRONTEND_URL=http://localhost:5173

# Firebase Realtime Database Configuration
# In production: https://<PROJECT_ID>-default-rtdb.firebaseio.com
# In local/testing: http://localhost:9000
FIREBASE_DATABASE_URL=https://smartsense-iot-default-rtdb.firebaseio.com

# Firebase Service Account Credentials (Admin SDK)
# Optional in offline/mock mode; required for real Firebase connection.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local / Mock Database Mode (true = fallback in-memory/REST mock if no admin credentials)
USE_MOCK_FIREBASE=false
