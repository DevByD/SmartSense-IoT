# SmartSense IoT Mobile Application - Environment Configuration
# Copy this file to .env or configure in your environment.
#
# NETWORK CONFIGURATION:
# - Browser / Web preview: http://localhost:5000/api
# - Android Emulator (standard): http://10.0.2.2:5000/api
# - iOS Simulator: http://localhost:5000/api
# - Physical Android / iPhone (Expo Go): http://<YOUR_COMPUTER_LAN_IP>:5000/api (e.g. http://192.168.1.50:5000/api)
# Note: Physical phones cannot resolve 'localhost'. Both phone and PC must be on the same Wi-Fi network.

EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
EXPO_PUBLIC_DEVICE_ID=smartsense-pi-01
